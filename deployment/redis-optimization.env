# Redis连接优化配置
# 用于解决生产环境中的Redis连接超时问题

# 基础Redis连接配置
REDIS_SOCKET_TIMEOUT=60
REDIS_SOCKET_CONNECT_TIMEOUT=10
REDIS_SOCKET_KEEPALIVE=True
REDIS_RETRY_ON_TIMEOUT=True
REDIS_MAX_CONNECTIONS=20

# Celery Broker配置
CELERY_BROKER_CONNECTION_TIMEOUT=60
CELERY_BROKER_CONNECTION_MAX_RETRIES=10
CELERY_BROKER_HEARTBEAT=60
CELERY_BROKER_POOL_LIMIT=20

# Celery任务配置
CELERY_TASK_TIME_LIMIT=2400
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_VISIBILITY_TIMEOUT=43200

# 用于生产环境的推荐配置
# 在docker-compose.yml中使用：
# environment:
#   - REDIS_SOCKET_TIMEOUT=${REDIS_SOCKET_TIMEOUT:-60}
#   - REDIS_SOCKET_CONNECT_TIMEOUT=${REDIS_SOCKET_CONNECT_TIMEOUT:-10}
#   - 其他配置... 